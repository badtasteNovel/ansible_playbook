# 複製這個檔案成 .env 並填入真實值，.env 不會進版控
# 注意：Taskfile 是用 bash `source` 讀這個檔案的，值裡面有空格（例如 portgroup
# 名稱常見的 "VM Network"）一定要加引號，不然 source 會把它拆成多個指令執行；
# 建議用單引號，雙引號裡的 $ 跟反引號還是會被 bash 展開，單引號才是完全照字面
#
# 這些是 SSH 進虛擬化主機、搬檔案用的連線資訊，跟是不是 ESXi 無關（我們不透過
# 任何 vSphere API，純粹 SSH + scp + 本地檔案系統工具），所以命名不綁 ESXi。
HYPERVISOR_HOSTNAME=192.168.1.10
HYPERVISOR_USERNAME=root
HYPERVISOR_PASSWORD=changeme
HYPERVISOR_DATASTORE=datastore1
HYPERVISOR_NETWORK='VM Network'

# 透過 WinRM 連本機 Windows（WSL2 的場景）用，見 inventory/windows.ini——
# 這個帳號要是 Windows 本機的系統管理員群組成員，才能改防火牆規則之類的設定
WINDOWS_USERNAME=changeme
WINDOWS_PASSWORD=changeme
