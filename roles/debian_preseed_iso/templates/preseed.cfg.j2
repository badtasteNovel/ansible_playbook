### Localization
d-i debian-installer/locale string {{ locale | default('en_US.UTF-8') }}
d-i keyboard-configuration/xkb-keymap select {{ keyboard_layout | default('us') }}

### Network configuration
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string {{ vm_hostname }}
d-i netcfg/get_domain string {{ vm_domain | default('') }}

### Mirror settings
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

### Account setup — 不設 root 密碼、直接停用 root 登入；
### 使用者帳號密碼鎖住（crypted 值填 "!"），只能用 SSH 金鑰登入
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string {{ vm_user }}
d-i passwd/username string {{ vm_user }}
d-i passwd/user-password-crypted password !
d-i passwd/user-default-groups string sudo

### Clock and time zone setup
d-i clock-setup/utc boolean true
d-i time/zone string {{ timezone | default('Asia/Taipei') }}
d-i clock-setup/ntp boolean true

### Partitioning — 引導式整顆磁碟 + LVM，分為 /、swap、/home
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string lvm
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto/choose_recipe select home
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### Base system installation
d-i base-installer/kernel/image string linux-image-amd64

### Package selection
tasksel tasksel/first multiselect standard
d-i pkgsel/include string openssh-server sudo open-vm-tools wireguard-tools
d-i pkgsel/upgrade select none
popularity-contest popularity-contest/participate boolean false

### Boot loader installation
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

### Finishing installation
d-i finish-install/reboot_in_progress note

### Late command — 寫入 SSH 公鑰、關閉密碼登入、開 NOPASSWD sudo（反正沒有密碼可輸入）、
### 換掉 openssh-server 自動生成的 host key，改用控制端預先產生好的那一組
### （/cdrom/ssh_host_key、/cdrom/ssh_host_key.pub 是 remaster-iso.sh 塞進 ISO 根目錄的檔案，
### 用複製檔案而不是在這裡塞金鑰內容，是為了避開私鑰裡的換行在這種單行 shell 指令字串裡轉義的問題）；
### 同一招也用在 wg0.conf 上。這台 VM 一定會被設成 WireGuard server，sshd 也一定會被鎖定成
### 只監聽 WireGuard 位址，所以下面這段完全沒有條件判斷，每次裝機都會執行。
###
### authorized_keys 那行前面的 from="..."/no-*-forwarding 是 OpenSSH 的
### authorized_keys 選項（寫在金鑰內容前面，逗號分隔），多一層限制：這把
### charlie 的 client 金鑰只接受從 WireGuard peer 子網（wireguard_peer_subnet）
### 連進來的連線才能用來登入，而且不能拿去做連線轉發／X11／agent forwarding。
### 用整個子網段而不是單一 peer 的 IP，是因為這把金鑰是共用的一把，不是每個
### peer 各自一把——鎖死某一個 peer 的 IP，其他後來加入的 peer 反而會被擋掉。
d-i preseed/late_command string \
  mkdir -p /target/home/{{ vm_user }}/.ssh; \
  echo 'from="{{ wireguard_peer_subnet }}",no-port-forwarding,no-X11-forwarding,no-agent-forwarding {{ ssh_public_key }}' > /target/home/{{ vm_user }}/.ssh/authorized_keys; \
  chmod 700 /target/home/{{ vm_user }}/.ssh; \
  chmod 600 /target/home/{{ vm_user }}/.ssh/authorized_keys; \
  in-target chown -R {{ vm_user }}:{{ vm_user }} /home/{{ vm_user }}/.ssh; \
  sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /target/etc/ssh/sshd_config; \
  sed -i '/^Port /d' /target/etc/ssh/sshd_config; \
  echo 'Port {{ ssh_port }}' >> /target/etc/ssh/sshd_config; \
  echo '{{ vm_user }} ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/{{ vm_user }}; \
  chmod 440 /target/etc/sudoers.d/{{ vm_user }}; \
  cp /cdrom/ssh_host_key /target/etc/ssh/ssh_host_ed25519_key; \
  cp /cdrom/ssh_host_key.pub /target/etc/ssh/ssh_host_ed25519_key.pub; \
  chmod 600 /target/etc/ssh/ssh_host_ed25519_key; \
  chmod 644 /target/etc/ssh/ssh_host_ed25519_key.pub; \
  chown root:root /target/etc/ssh/ssh_host_ed25519_key /target/etc/ssh/ssh_host_ed25519_key.pub; \
  mkdir -p /target/etc/wireguard; \
  cp /cdrom/wg0.conf /target/etc/wireguard/wg0.conf; \
  chmod 600 /target/etc/wireguard/wg0.conf; \
  chown root:root /target/etc/wireguard/wg0.conf; \
  in-target systemctl enable wg-quick@wg0; \
  sed -i '/^ListenAddress /d' /target/etc/ssh/sshd_config; \
  echo 'ListenAddress {{ wireguard_vm_address }}' >> /target/etc/ssh/sshd_config; \
  mkdir -p /target/etc/systemd/system/ssh.service.d; \
  echo '[Unit]' > /target/etc/systemd/system/ssh.service.d/wireguard.conf; \
  echo 'After=wg-quick@wg0.service' >> /target/etc/systemd/system/ssh.service.d/wireguard.conf; \
  echo 'Requires=wg-quick@wg0.service' >> /target/etc/systemd/system/ssh.service.d/wireguard.conf; \
  true
